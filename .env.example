# Galavant env vars — copy to .env.local for development

# Firecrawl scraping
FIRECRAWL_API_KEY=fc-...

# LLM provider — OpenRouter (default: Kimi K2). Provision at openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Optional model override (default: moonshotai/kimi-k2)
# OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# App auth
APP_PASSWORD=change-me-shared-password
AUTH_SECRET=replace-with-32-bytes-random-base64

# GitHub commit (for /admin/skill and skill-suggest approve)
GITHUB_TOKEN=ghp-...
GITHUB_REPO=franticOreo/galavant

# Vercel KV (auto-injected on Vercel; for local: leave blank to disable rate limit)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Deployment Protection bypass — only needed if Deployment Protection is enabled.
# Create in: Vercel Dashboard → Project → Settings → Deployment Protection → Protection Bypass for Automation
# Smoke-test and automation scripts must send: x-vercel-protection-bypass: <this value>
# Leave blank when protection is off (default for new projects).
VERCEL_BYPASS_SECRET=
